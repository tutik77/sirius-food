{
  "consumer": {
    "name": "kitchen"
  },
  "interactions": [
    {
      "contents": {
        "content": {
          "event_id": null,
          "order_id": 42
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "an order.paid event",
      "generators": {
        "body": {
          "$.event_id": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.event_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12})$"
              }
            ]
          },
          "$.order_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "pending": false,
      "type": "Asynchronous/Messages"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.13",
      "models": "1.3.18"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "orders"
  }
}