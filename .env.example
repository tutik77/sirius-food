# Скопируйте в .env и задайте свои значения. Файл .env в Git не коммитится.

# Обязательно. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Обязательно.
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food

REDIS_URL=redis://127.0.0.1:6379

# True только для локальной разработки: включает Swagger (/docs) и /openapi.json.
DEBUG=False

# Домены фронтенда, которым разрешены CORS-запросы.
ALLOWED_ORIGINS=["https://sirius-food.ru"]

# postgres | memory
STORAGE_BACKEND=postgres
